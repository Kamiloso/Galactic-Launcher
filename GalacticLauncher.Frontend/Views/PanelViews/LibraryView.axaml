<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GalacticLauncher.Frontend.Views.PanelViews.LibraryView"
             xmlns:vm="using:GalacticLauncher.Frontend.ViewModels.Panels"
             xmlns:btn="clr-namespace:GalacticLauncher.Frontend.ViewModels.GameButtons"
             x:DataType="vm:LibraryViewModel"
             x:CompileBindings="True">
	<Grid>
		<Grid RowDefinitions="Auto,Auto"
              Margin="30,20,30,50">

			<Grid ColumnDefinitions="*, Auto" HorizontalAlignment="Stretch" Grid.Row="0">
				<TextBlock Classes="slogan"
                           Text="LIBRARY"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
						   FontSize="35"
                           Grid.Column="0"/>
			</Grid>
			<Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center">
				<Button Classes="favouriteAll"
                        Content="YOUR GAMES"
                        Classes.active="{Binding IsYourGamesPage}"
                        Command="{Binding ChangeViewCommand}"
                        CommandParameter="{x:Static vm:LibraryViewModel+LibraryViewMode.YourGames}"
                        Grid.Column="0">
				</Button>
				<Button Classes="favouriteAll"
                        Content="FAVORITES"
                        Classes.active="{Binding IsFavoritePage}"
                        Command="{Binding ChangeViewCommand}"
                        CommandParameter="{x:Static vm:LibraryViewModel+LibraryViewMode.Favorites}"
                        Grid.Column="1">
				</Button>
				<Button Classes="favouriteAll"
                        Content="FIND NEW GAMES"
                        Classes.active="{Binding IsMoreGamesPage}"
                        Command="{Binding ChangeViewCommand}"
                        CommandParameter="{x:Static vm:LibraryViewModel+LibraryViewMode.MoreGames}"
                        Grid.Column="2">
				</Button>
			</Grid>
		</Grid>

		<!--Search games/tags-->

		<Border Classes="SearchBorder"
                Padding="15,15,15,30"
                HorizontalAlignment="Right"
                Width="250"
                Margin="30,120,30,30">

			<Grid RowDefinitions="35,30,35,30,Auto,*">
				<Grid Grid.Row="0">
					<StackPanel Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
						<PathIcon Data="{StaticResource IconSearch}"
                                  Height="15"
                                  Width="15"
                                  Margin="0,0,0,2"/>
						<TextBlock Classes="searchHeader"
                                   Text="SEARCH LIBRARY"/>
					</StackPanel>
				</Grid>

				<Border Grid.Row="1"
                        Classes="GameSearchBorder"
                        Height="30"
                        VerticalAlignment="Center">
					<TextBox Classes="galaxyTextBox"
                             Text="{Binding SearchGames}"/>
				</Border>
				<Grid Grid.Row="2">
					<StackPanel Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="0,10,0,0">
						<PathIcon Data="{StaticResource IconSearch}"/>
						<TextBlock Classes="searchHeader"
                                   Text="SEARCH TAGS"/>
					</StackPanel>
				</Grid>

				<Border Grid.Row="3"
                        Classes="TagSearchBorder"
                        Height="30"
                        Margin="0,0,0,10"
                        VerticalAlignment="Center"
						ClipToBounds="True">
					<TextBox Classes="galaxyTextBox"
<<<<<<< Updated upstream:GalacticLauncher.Frontend/Views/PanelViews/LibraryView.axaml
