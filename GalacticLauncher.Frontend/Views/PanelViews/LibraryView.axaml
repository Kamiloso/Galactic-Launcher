				</Border>

				<ScrollViewer HorizontalScrollBarVisibility="Disabled"
								  VerticalScrollBarVisibility="Auto"
								  AllowAutoHide="False"
								  Grid.Row="4"
								 MaxHeight="100">
					<ItemsControl ItemsSource="{Binding SelectedTags}"
						  Grid.Row="4"
						  Margin="0,0,0,10">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel Orientation="Horizontal"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Button Classes="tagButton active"
										Command="{Binding $parent[ItemsControl].DataContext.UnselectTagCommand}"
										CommandParameter="{Binding}"
										FontSize="14"
										Height="27">

									<TextBlock Text="{Binding Name}"/>
								</Button>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>

				<Border Classes="TagsBorder"
						Padding="10,10,10,10"
						Margin="0,10,0,10"
						ClipToBounds="True"
						Grid.Row="5"
						MinHeight="170">

					<ScrollViewer HorizontalScrollBarVisibility="Disabled"
								  VerticalScrollBarVisibility="Auto"
								  AllowAutoHide="False">
						<Panel>
							<ItemsControl ItemsSource="{Binding AvailableTags}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Button Classes="tagButton inactive"
												Command="{Binding $parent[ItemsControl].DataContext.SelectTagCommand}"
												CommandParameter="{Binding}"
												FontSize="14"
												Height="27"
												MaxWidth="100">
											<TextBlock Text="{Binding Name}"/>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						<TextBlock Text="NO TAGS FOUND"
								   IsVisible="{Binding !AvailableTags.Count}"
								   FontFamily="{DynamicResource Roboto}"
								   FontSize="10"
								   FontWeight="Bold"
								   Foreground="{StaticResource GreyBlue}"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center"/>
							
						</Panel>
					</ScrollViewer>
				</Border>
			</Grid>
		</Border>

		<!--Games from library-->

		<Border Classes="galaxyBorder"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Margin="30,120,300,30"
                Padding="20,20,20,20">

				<ScrollViewer Classes="ScrollBar"
							  HorizontalScrollBarVisibility="Disabled"
							  VerticalScrollBarVisibility="Auto"
							  ClipToBounds="False"
							  AllowAutoHide="False">

					<Panel>

						<ItemsControl ItemsSource="{Binding GameControls}"
									  Background="Transparent"
									  Margin="0,0,0,0">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Orientation="Vertical"
												Spacing="20"/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>

							<ItemsControl.ItemTemplate>
								<DataTemplate>
										<Button Classes="libraryGameButton"
												Command="{Binding ShowGameCommand}"
												HorizontalAlignment="Stretch"/>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<ContentControl Classes="noFound"
									Tag="GAMES NOT FOUND"
									IsVisible="{Binding !GameControls.Count}"
									VerticalAlignment="Center"
									HorizontalAlignment="Center"
									FontSize="30"/>
						
				</Panel>
			</ScrollViewer>
		</Border>
	</Grid>
</UserControl>