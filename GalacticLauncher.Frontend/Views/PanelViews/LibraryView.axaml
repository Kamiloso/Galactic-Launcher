												Height="27"
												MaxWidth="100">
											<TextBlock Text="{Binding Name}"/>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						<TextBlock Text="NO TAGS FOUND"
								   IsVisible="{Binding !AvailableTags.Count}"
								   FontFamily="{DynamicResource Roboto}"
								   FontSize="10"
								   FontWeight="Bold"
								   Foreground="{StaticResource GreyBlue}"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center"/>
							
						</Panel>
					</ScrollViewer>
>>>>>>> Stashed changes:GalacticLauncher.Frontend/Views/PanelViews/LibraryView.axaml
