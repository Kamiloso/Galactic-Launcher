<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GalacticLauncher.Frontend.Views.PanelViews.GameView"
             xmlns:vm="using:GalacticLauncher.Frontend.ViewModels.Panels"
             x:DataType="vm:GameViewModel">

	<!--Game view-->
	<ScrollViewer Classes="ScrollBar"
			  HorizontalScrollBarVisibility="Disabled"
			  VerticalScrollBarVisibility="Auto">
	<Grid>
		<!--only the galaxy border for looks-->
		<Border Classes="galaxyBorder"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				Margin="35,35,35,35"
				ClipToBounds="True"
				Padding="30,30,30,30">

			<StackPanel Orientation="Vertical">

				<!--Banner-->
				<Viewbox Stretch="Uniform"
						 HorizontalAlignment="Stretch"
						 VerticalAlignment="Top"
						 Grid.Row="0"
						 Margin="0,0,0,10">

					<Border Width="1024"
							Height="300"
							CornerRadius="0"
							ClipToBounds="True"
							BorderBrush="{DynamicResource GalaxyGradient}"
							BorderThickness="4">

						<!--Banner image-->
						<Image Source="/AvaloniaResources/Assets/Placeholders/banner.png"
							   Stretch="UniformToFill"/>
					</Border>
				</Viewbox>


				 <StackPanel Orientation="Vertical">

					 <Grid ColumnDefinitions="*,Auto"
						   VerticalAlignment="Center">


						 
							 
						 <Grid RowDefinitions="Auto,Auto"
							   Grid.Column="0"
							   VerticalAlignment="Center"
							   Margin="0,20,0,0">

							<!--Title-->
							<TextBlock Classes="slogan"
									   VerticalAlignment="Center"
									   HorizontalAlignment="Stretch"
									   TextTrimming="CharacterEllipsis"
									   TextWrapping="Wrap"
									   FontSize="38"
									   Text="{Binding Title}"
									   Grid.Row="0"
									   Margin="0,0,0,0">
							</TextBlock>

							 <!--Author-->
							 <TextBlock Classes="searchHeader"
										VerticalAlignment="Top"
										HorizontalAlignment="Stretch"
										TextTrimming="CharacterEllipsis"
										TextWrapping="Wrap"
										FontSize="15"
										Foreground="{StaticResource GreyBlue}"
										Text="AUTHOR: GRZEGORZ BRZĘCZYSZCZYKIEWICZ"
										Grid.Row="1"
										Margin="0,0,0,0">
							 </TextBlock>
						</Grid>

						 <Grid RowDefinitions="*,Auto"
							   Grid.Column="1"
							   VerticalAlignment="Center"
							   Margin="0,20,0,0">

							 <StackPanel Orientation="Horizontal"
										 Spacing="10"
										 Grid.Row="0"
										 HorizontalAlignment="Right"
										 VerticalAlignment="Center">

								 <!--Download button-->
								 <Button Classes="play"
										 VerticalAlignment="Center"
										 Content="{Binding DownloadButtonText}"
										 Command="{Binding DownloadSelectedVersionCommand}"
										 IsEnabled="{Binding IsNoInstanceState}"
										 IsVisible="{Binding IsNoInstanceState}"/>

								 <!--Play button-->
								 <Button Classes="play"
										 Content="PLAY"
										 VerticalAlignment="Center"
										 Command="{Binding PlaySelectedVersionCommand}"
										 IsEnabled="{Binding IsReadyToPlayState}"
										 IsVisible="{Binding IsReadyToPlayState}"/>

								 <!--Uninstall button-->
								 <Button Classes="play"
										 Content="UNINSTALL"
										 VerticalAlignment="Center"
										 Command="{Binding DeleteSelectedVersionCommand}"
										 IsEnabled="{Binding IsReadyToPlayState}"
										 IsVisible="{Binding IsReadyToPlayState}"
										 Background="{StaticResource TagBlue}"/>
							 </StackPanel>

							 <TextBlock Classes="searchHeader"
										HorizontalAlignment="Right"
										VerticalAlignment="Center"
										FontSize="15"
										Text="{Binding SelectedVersion.Caption, StringFormat='VERSION: {0}'}"
										Grid.Row="1"
										Foreground="{StaticResource GreyBlue}"
										Margin="0,10,0,0"/>
						 </Grid>

					</Grid>


					


					<!--Tags-->
					<!--
					<ItemsControl Background="Transparent">
						
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel Orientation="Horizontal"
										   HorizontalAlignment="Left"
										   VerticalAlignment="Center"
										   ItemWidth="Auto"
										   ItemHeight="Auto"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>

						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Button Classes="tagButton"
									    IsEnabled="false"
									    Tag="ROMANCE"
									    Margin="0,0,10,10">
									</Button>
								</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					-->

					 <Border Classes="gameViewBorder" Margin="0,30,0,0">
						 <StackPanel Orientation="Vertical">
							 <TextBlock Classes="gameTitle"
							   VerticalAlignment="Center"
							   HorizontalAlignment="Stretch"
							   TextTrimming="CharacterEllipsis"
							   TextWrapping="Wrap"
							   FontSize="20"
							   Margin="0,0,0,10"
							   Text="DESCRIPTION">
							 </TextBlock>

							 <!--Description-->
							 <TextBlock Classes="searchHeader"
										VerticalAlignment="Center"
										HorizontalAlignment="Stretch"
										TextTrimming="CharacterEllipsis"
										TextWrapping="Wrap"
										FontSize="15"
										Text="{Binding Description}"
										Grid.Column="0"
										Foreground="{StaticResource GreyBlue}">
							 </TextBlock>
						 </StackPanel>
					 </Border>


					 <Border Classes="gameViewBorder" Margin="0,30,0,0">
						 <StackPanel Orientation="Vertical">
							 <!--Versions-->
							 <TextBlock Classes="gameTitle"
										VerticalAlignment="Center"
										HorizontalAlignment="Stretch"
										TextTrimming="CharacterEllipsis"
										TextWrapping="Wrap"
										FontSize="20"
										Text="Versions"
										Margin="0,0,0,5">
							 </TextBlock>

							 <Border Classes="gameViewBorder"
									 Background="{StaticResource GridColor}"
									 CornerRadius="0"
									 Padding="2,2,2,2">
								 
								 <DataGrid ItemsSource="{Binding AvailableVersions}"
									   SelectedItem="{Binding SelectedVersion}"
									   AutoGenerateColumns="False"
									   IsReadOnly="True"
									   BorderThickness="0"
									   GridLinesVisibility="None"
									   SelectionMode="Single"
									   Background="{StaticResource AmostBlack}">

									 <DataGrid.Styles>
										 <Style Selector="DataGrid /template/ DataGridRowsPresenter">
											 <Setter Property="Focusable" Value="False"/>
										 </Style>
									 </DataGrid.Styles>

									 <DataGrid.Columns>
										 <DataGridTemplateColumn Header="VERSION" Width="*">
											 <DataTemplate>
												 <TextBlock VerticalAlignment="Center" Margin="5,0">
													 <TextBlock.Text>
														 <MultiBinding StringFormat="{}{0} ({1})">
															 <Binding Path="Caption"/>
															 <Binding Path="Type"/>
														 </MultiBinding>
													 </TextBlock.Text>
												 </TextBlock>
											 </DataTemplate>
										 </DataGridTemplateColumn>

										 <DataGridTemplateColumn Header="PLATFORM" Width="Auto">
											 <DataTemplate>
												 <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">

													 <PathIcon Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0">
														 <PathIcon.Styles>
															 <Style Selector="PathIcon[Tag=windows]">
																 <Setter Property="Data" Value="{StaticResource IconWindows}"/>
															 </Style>
															 <Style Selector="PathIcon[Tag=linux]">
																 <Setter Property="Data" Value="{StaticResource IconLinux}"/>
															 </Style>
															 <Style Selector="PathIcon[Tag=macsilicon]">
																 <Setter Property="Data" Value="{StaticResource IconMac}"/>
															 </Style>
															 <Style Selector="PathIcon[Tag=macintel]">
																 <Setter Property="Data" Value="{StaticResource IconMac}"/>
															 </Style>
														 </PathIcon.Styles>
														 <PathIcon.Tag>
															 <Binding Path="Platform"/>
														 </PathIcon.Tag>
													 </PathIcon>

													 <TextBlock Text="{Binding Platform}" VerticalAlignment="Center"/>
												 </StackPanel>
											 </DataTemplate>
										 </DataGridTemplateColumn>

										 <DataGridTemplateColumn Header="DESCRIPTION" Width="200">
											 <DataTemplate>
												 <TextBlock Text="{Binding Description}"
															TextWrapping="Wrap"
															VerticalAlignment="Center"
															Margin="5,0"/>
											 </DataTemplate>
										 </DataGridTemplateColumn>

										 <DataGridTemplateColumn Header="PRIMARY" Width="Auto">
											 <DataTemplate>
												 <TextBlock Text="{Binding IsPrimary}" VerticalAlignment="Center" Margin="5,0"/>
											 </DataTemplate>
										 </DataGridTemplateColumn>

										 <DataGridTemplateColumn Header="ALERT" Width="200">
											 <DataTemplate>
												 <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">

													 <PathIcon Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0">
														 <PathIcon.Styles>
															 <Style Selector="PathIcon[Tag=stable]">
																 <Setter Property="Data" Value="{StaticResource IconShield}"/>
																 <Setter Property="Foreground" Value="LightGreen"/>
															 </Style>
															 <Style Selector="PathIcon[Tag=alert]">
																 <Setter Property="Data" Value="{StaticResource IconAlert}"/>
																 <Setter Property="Foreground" Value="Orange"/>
															 </Style>
															 <Style Selector="PathIcon[Tag=danger]">
																 <Setter Property="Data" Value="{StaticResource IconDanger}"/>
																 <Setter Property="Foreground" Value="Crimson"/>
															 </Style>
														 </PathIcon.Styles>
														 <PathIcon.Tag>
															 <Binding Path="Alert"/>
														 </PathIcon.Tag>
													 </PathIcon>

													 <TextBlock Text="{Binding Alert}" VerticalAlignment="Center"/>
												 </StackPanel>
											 </DataTemplate>
										 </DataGridTemplateColumn>

									 </DataGrid.Columns>
								 </DataGrid>
							 </Border>
						 </StackPanel>
					 </Border>


					 <Border Classes="gameViewBorder" Margin="0,30,0,10">
						 <StackPanel Orientation="Vertical">
							 <!--ScreenShots-->
							 <TextBlock Classes="gameTitle"
										VerticalAlignment="Center"
										HorizontalAlignment="Stretch"
										TextTrimming="CharacterEllipsis"
										TextWrapping="Wrap"
										FontSize="20"
										Text="SCREENSHOTS"
										Margin="0,0,0,10">
							 </TextBlock>
						 </StackPanel>
					 </Border>
					
					</StackPanel>
				</StackPanel>
			</Border>
		</Grid>
	</ScrollViewer>
</UserControl>