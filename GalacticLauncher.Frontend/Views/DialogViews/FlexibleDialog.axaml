<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:GalacticLauncher.Frontend.ViewModels.Dialogs"
             xmlns:controls="clr-namespace:GalacticLauncher.Frontend.Views.Controls"
             x:Class="GalacticLauncher.Frontend.Views.DialogViews.FlexibleDialog"
             x:DataType="dialogs:FlexibleDialogViewModel">

	<controls:MovableBorder Background="#2D2D30"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            CornerRadius="8" Padding="32" MinWidth="350"
                            BoxShadow="0 8 32 0 #66000000">

		<StackPanel Spacing="16">

			<TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="White"/>
			<TextBlock Text="{Binding Message}" FontSize="16" Foreground="#CCCCCC" TextWrapping="Wrap"/>

			<ItemsControl ItemsSource="{Binding Inputs}" HorizontalAlignment="Stretch" Margin="-4,16,-4,0">
             
             <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                   <StackPanel Orientation="Vertical" Spacing="12" />
                </ItemsPanelTemplate>
             </ItemsControl.ItemsPanel>

             <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="dialogs:TextInputViewModel">
                   
                   <StackPanel Margin="4,0" Spacing="6">

					   <TextBlock Text="{Binding Label}"
								FontSize="16"
								Foreground="White"
								Opacity="0.8"
								HorizontalAlignment="Left" />

					   <TextBox Text="{Binding Text}"
								Watermark="{Binding Watermark}"
								PasswordChar="{Binding PasswordChar}"
								FontSize="16"
								Padding="12,10"
								MinHeight="45"
								MaxHeight="50"
								Background="#1E1E1E"
								Foreground="White"
								BorderBrush="#333333"
								BorderThickness="1"
								CornerRadius="4"
								AcceptsReturn="False">
						   <TextBox.Styles>
							   <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
								   <Setter Property="Background" Value="#252525"/>
								   <Setter Property="BorderBrush" Value="#555555"/>
							   </Style>
							   <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
								   <Setter Property="Background" Value="#1E1E1E"/>
								   <Setter Property="BorderBrush" Value="#888888"/>
								   <Setter Property="BorderThickness" Value="1"/>
							   </Style>
						   </TextBox.Styles>
					   </TextBox>
                   </StackPanel>
                        
                </DataTemplate>
             </ItemsControl.ItemTemplate>
          </ItemsControl>

			<ItemsControl ItemsSource="{Binding Buttons}" HorizontalAlignment="Stretch" Margin="-16,16,-16,0">

				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<UniformGrid Rows="1" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="dialogs:DialogButtonViewModel">
						<Panel HorizontalAlignment="{ReflectionBinding Alignment}" Margin="8,0">

							<Button Content="{Binding Text}"
									Command="{Binding ClickCommand}"
									IsVisible="{Binding !IsHighlighted}"
									IsEnabled="{Binding Interactable}"
									HorizontalContentAlignment="Center"
									Background="#404040"
									Foreground="White"
									Padding="20,8"
									CornerRadius="4"
									Cursor="Hand">
								<Button.Styles>
									<Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
										<Setter Property="Background" Value="#5C5C5C"/>
										<Setter Property="TextBlock.Foreground" Value="White"/>
									</Style>
									<Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
										<Setter Property="Background" Value="#2A2A2A"/>
									</Style>
								</Button.Styles>
							</Button>

							<Button Content="{Binding Text}"
									Command="{Binding ClickCommand}"
									IsVisible="{Binding IsHighlighted}"
									IsEnabled="{Binding Interactable}"
									HorizontalContentAlignment="Center"
									Background="{DynamicResource GalaxyGradient}"
									Foreground="White"
									Padding="20,8"
									CornerRadius="4"
									FontWeight="Bold"
									Cursor="Hand">
								<Button.Styles>
									<Style Selector="Button:pointerover">
										<Setter Property="Opacity" Value="0.85"/>
									</Style>

									<Style Selector="Button:pressed">
										<Setter Property="Opacity" Value="0.65"/>
									</Style>

									<Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
										<Setter Property="Background" Value="{DynamicResource GalaxyGradient}"/>
										<Setter Property="TextBlock.Foreground" Value="White"/>
									</Style>
									<Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
										<Setter Property="Background" Value="{DynamicResource GalaxyGradient}"/>
									</Style>
								</Button.Styles>
							</Button>

						</Panel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>

			</ItemsControl>

		</StackPanel>
	</controls:MovableBorder>
</UserControl>